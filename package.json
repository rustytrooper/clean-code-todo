{
    "name": "clean-code-todo",
    "version": "1.0.0",
    "description": "Учебный репозиторий для задания [«Clean Code»](https://github.com/rolling-scopes-school/tasks/blob/master/fullstack-engineering/tasks/clean-code/README.md) курса RS School Fullstack Engineering.",
    "homepage": "https://github.com/rustytrooper/clean-code-todo#readme",
    "bugs": {
        "url": "https://github.com/rustytrooper/clean-code-todo/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rustytrooper/clean-code-todo.git"
    },
    "type": "commonjs",
    "main": "app.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "prepare": "husky",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write ."
    },
    "lint-staged": {
        "*.{js,mjs,cjs}": [
            "eslint",
            "prettier --check"
        ],
        "*.{html,css,json,md}": [
            "prettier --check"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.10"
    }
}
